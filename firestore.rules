rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Moderator/admin — profil sənədində işarələnir.
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('isAdmin', false) == true;
    }

    // USERS
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isMe(userId);

      // Admin hesabı dayandıra/bərpa edə bilər.
      allow update: if isAdmin();

      // Başqaları YALNIZ bu alt kolleksiyalara yaza bilər:
      // bildiriş göndərmək, izləmək və bloklamaq üçün lazımdır.
      match /notifications/{docId} {
        allow read, write: if signedIn();
      }
      match /followers/{docId} {
        allow read, write: if signedIn();
      }
      match /blockedBy/{docId} {
        allow read, write: if signedIn();
      }

      // Qalan hər şey (media, qalereya, pul kisəsi, tokenlər, bloklananlar…)
      // yalnız sahibi tərəfindən dəyişdirilə bilər.
      // savedMoments / hiddenMoments / mutedUsers — yalniz sahibi ucun.
      // Bunlar sexsi siyahilardir: kimi sessize almagini basqasi gormemelidir.
      match /savedMoments/{docId} {
        allow read, write: if isMe(userId);
      }

      match /hiddenMoments/{docId} {
        allow read, write: if isMe(userId);
      }

      match /mutedUsers/{docId} {
        allow read, write: if isMe(userId);
      }

      match /{subCollection}/{docId} {
        allow read: if signedIn();
        allow write: if isMe(userId);
      }
    }

    // PRIVATE CHATS
    match /chats/{chatId} {
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members;

      allow read: if signedIn()
        && request.auth.uid in resource.data.members;

      allow delete: if signedIn()
        && request.auth.uid in resource.data.members;

      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        // Movzu suzgeci sohbeti baglayibsa, terefler kilidi
        // qisaltmir. Yalniz saxlamaq ve ya uzatmaq olar —
        // eks halda kilidi telefonda acmaq olardi.
        && request.resource.data.get('lockedUntil', request.time)
           >= resource.data.get('lockedUntil', request.time);

      match /messages/{messageId} {
        // Mövcud vəziyyət (oxumaq/silmək üçün).
        function chatNow() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        // Batch-dən SONRAKI vəziyyət. İlk mesaj göndəriləndə söhbət sənədi
        // eyni batch-də yaradılır — `get` onu görmür, `getAfter` görür.
        function chatAfter() {
          return getAfter(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        allow read: if signedIn()
          && request.auth.uid in chatNow().members;

        allow create: if signedIn()
          && request.auth.uid in chatAfter().members
          && request.resource.data.senderId == request.auth.uid
          // Kimsə bloklanıbsa, heç kim yaza bilmir.
          && chatAfter().get('blockedBy', []).size() == 0
          // Sohbet movzu suzgecine gore baglanibsa, mesaj getmir.
          // Bu yoxlama serverdedir: yalniz ekranda gizletmek
          // kifayet deyil, cunki muraciet birbasa da gonderile bilir.
          && chatAfter().get('lockedUntil', request.time) <= request.time;

        // Reaksiya və mesaj vəziyyəti dəyişiklikləri üçün.
        allow update: if signedIn()
          && request.auth.uid in chatNow().members;

        allow delete: if signedIn()
          && request.auth.uid in chatNow().members
          && resource.data.senderId == request.auth.uid;

        // Şəkilin tam ölçülü nüsxəsi ayrıca sənəddə saxlanılır.
        // Bu qayda olmadan şəkil göndərmək mümkün deyil.
        match /media/{mediaId} {
          allow read: if signedIn()
            && request.auth.uid in chatNow().members;

          allow write: if signedIn()
            && request.auth.uid in chatAfter().members;
        }
      }
    }

    // 1-to-1 CALL SIGNALING
    match /calls/{callId} {
      allow read, create, update, delete: if signedIn();

      match /callerCandidates/{candidateId} {
        allow read, write: if signedIn();
      }

      match /calleeCandidates/{candidateId} {
        allow read, write: if signedIn();
      }
    }

    // MOMENTS
    match /moments/{momentId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      // Sahib hər şeyi dəyişə bilər; başqaları YALNIZ sayğacları
      // ("Populyar" sıralaması üçün).
      allow update: if signedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likeCount', 'commentCount'])
        );

      // Sahib və ya admin silə bilər (moderasiya).
      allow delete: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin());

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, update, delete: if isMe(uid);
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;
        allow update: if signedIn()
          && resource.data.uid == request.auth.uid;
        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid || isAdmin());

        match /likes/{uid} {
          allow read: if signedIn();
          allow create, update, delete: if isMe(uid);
        }
      }
    }

    // VIDEOS
    match /videos/{videoId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      // Owner edits/deletes; view/share counters can also be updated by signed-in viewers.
      allow update: if signedIn();
      allow delete: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin());

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, update, delete: if isMe(uid);
      }

      match /reposts/{uid} {
        allow read: if signedIn();
        allow create, update, delete: if isMe(uid);
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if signedIn()
          && resource.data.uid == request.auth.uid;

        match /likes/{uid} {
          allow read: if signedIn();
          allow create, update, delete: if isMe(uid);
        }
      }
    }

    // PARTY ROOMS
    //
    // `{document=**}` lazımdır: canlı səsin siqnallaşması
    // rtc/{cüt}/a/{namizəd} kimi iki səviyyə dərinlikdədir.
    match /partyRooms/{roomId} {
      allow read, write: if signedIn();

      match /{document=**} {
        allow read, write: if signedIn();
      }
    }

    // LEGACY SOCIAL ROOMS
    match /socialRooms/{roomId} {
      allow read, write: if signedIn();

      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
    }

    // DOMINO OYUNLARI
    //
    // Sənədi yalnız oyunun iki iştirakçısı oxuyub yaza bilər.
    match /dominoMatches/{matchId} {
      allow create: if signedIn()
        && request.resource.data.players is list
        && request.auth.uid in request.resource.data.players;

      allow read, update, delete: if signedIn()
        && request.auth.uid in resource.data.players;
    }

    // REPORTS
    match /reports/{reportId} {
      allow create: if signedIn();
      // Şikayətləri yalnız admin görür və bağlayır.
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // STORILER — 24 saatliq paylasimlar
    match /stories/{storyId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      // Baxis sayğaci herkes terefinden artirila biler; qalan sahelere
      // yalniz sahibi toxuna biler.
      allow update: if signedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['viewCount'])
        );

      allow delete: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin());

      // Kimin baxdigi — yalniz oz qeydini yaza bilersen.
      match /views/{uid} {
        allow read: if signedIn();
        allow write: if isMe(uid);
      }
    }

    // PICILTI (anonim ses divari)
    //
    // Anonimlik oxuyan ucundur: ad ekranda gorunmur, amma authorUid
    // senedde qalir ki, sikayet olunanda moderator kimi tapa bilsin.
    match /whispers/{whisperId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid;

      // Herkes yalniz sayğaclari arttira biler: begenme ve sikayet.
      // Melumatin ozunu deyisdirmek olmur.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likeCount', 'reportCount'])
        && request.resource.data.get('likeCount', 0) >= resource.data.get('likeCount', 0)
        && request.resource.data.get('reportCount', 0) >= resource.data.get('reportCount', 0);

      // Sahibi ve ya moderator silir / gizledir.
      allow delete: if signedIn()
        && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // AILELER (klan)
    match /families/{familyId} {
      allow read: if signedIn();

      // Yaradan yalniz oz adina aile aca biler.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      // Uzv sayi ve xezine her uzvun emeli ile deyisir (qosulma, tohfe),
      // ona gore yenileme giris etmis herkese aciqdir. Silmek yalniz
      // qurucunun ve ya adminin isidir.
      allow update: if signedIn();
      allow delete: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin());

      match /members/{uid} {
        allow read: if signedIn();
        // Ozunu elave edib cixara bilersen; qurucu bashqasini cixara biler.
        allow write: if isMe(uid)
          || get(/databases/$(database)/documents/families/$(familyId))
               .data.ownerUid == request.auth.uid
          || isAdmin();
      }
    }

    // REYTINQ LOVHELERI
    //
    // rankings/{dovr}/users/{uid} ve rankings/{dovr}/rooms/{roomId}.
    // Hediyye gonderilende tranzaksiya icinde yazilir.
    //
    // Qeyd: yazma huququ her giris etmis istifadeciyededir, cunki sikke
    // hesabi da hazirda muştəri terefinde aparilir (users.giftSent eyni
    // sekildedir). Yeni xal yalnız artırıla bilər — azaltma bloklanır ki,
    // basqasinin xalini sifirlamaq mumkun olmasin.
    match /rankings/{period} {
      allow read: if signedIn();
      allow write: if signedIn();

      match /users/{uid} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update: if signedIn()
          && request.resource.data.get('sent', 0) >= resource.data.get('sent', 0)
          && request.resource.data.get('received', 0) >= resource.data.get('received', 0);
        allow delete: if isAdmin();
      }

      match /rooms/{roomId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update: if signedIn()
          && request.resource.data.get('total', 0) >= resource.data.get('total', 0);
        allow delete: if isAdmin();
      }
    }

    // LEGACY POSTS
    match /posts/{postId} {
      allow read, write: if signedIn();
    }
  }
}
