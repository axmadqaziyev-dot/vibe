rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // USERS
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isMe(userId);

      // VIBE currently uses these nested collections for social/video state.
      // Kept open to signed-in users so follow/notification flows work.
      match /{subCollection}/{docId} {
        allow read, write: if signedIn();
      }
    }

    // PRIVATE CHATS
    match /chats/{chatId} {
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members;

      allow read: if signedIn()
        && request.auth.uid in resource.data.members;

      allow update, delete: if signedIn()
        && request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        function chatMembers() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }

        allow read: if signedIn()
          && request.auth.uid in chatMembers();

        allow create: if signedIn()
          && request.auth.uid in chatMembers()
          && request.resource.data.senderId == request.auth.uid;

        // Needed for reactions and message state changes.
        allow update: if signedIn()
          && request.auth.uid in chatMembers();

        allow delete: if signedIn()
          && request.auth.uid in chatMembers()
          && resource.data.senderId == request.auth.uid;
      }
    }

    // 1-to-1 CALL SIGNALING
    match /calls/{callId} {
      allow read, create, update, delete: if signedIn();

      match /callerCandidates/{candidateId} {
        allow read, write: if signedIn();
      }

      match /calleeCandidates/{candidateId} {
        allow read, write: if signedIn();
      }
    }

    // MOMENTS
    match /moments/{momentId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, update, delete: if isMe(uid);
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if signedIn()
          && resource.data.uid == request.auth.uid;

        match /likes/{uid} {
          allow read: if signedIn();
          allow create, update, delete: if isMe(uid);
        }
      }
    }

    // VIDEOS
    match /videos/{videoId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      // Owner edits/deletes; view/share counters can also be updated by signed-in viewers.
      allow update: if signedIn();
      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, update, delete: if isMe(uid);
      }

      match /reposts/{uid} {
        allow read: if signedIn();
        allow create, update, delete: if isMe(uid);
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if signedIn()
          && resource.data.uid == request.auth.uid;

        match /likes/{uid} {
          allow read: if signedIn();
          allow create, update, delete: if isMe(uid);
        }
      }
    }

    // PARTY ROOMS
    match /partyRooms/{roomId} {
      allow read, write: if signedIn();

      match /{subCollection}/{docId} {
        allow read, write: if signedIn();
      }
    }

    // LEGACY SOCIAL ROOMS
    match /socialRooms/{roomId} {
      allow read, write: if signedIn();

      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
    }

    // REPORTS
    match /reports/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // LEGACY POSTS
    match /posts/{postId} {
      allow read, write: if signedIn();
    }
  }
}
