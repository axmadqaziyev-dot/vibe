// Merge this match block INSIDE /databases/{database}/documents in your
// existing Firestore rules. This is not a replacement for users/chat rules.
match /calls/{callId} {
  function member() {
    return request.auth != null && request.auth.uid in resource.data.members;
  }
  allow read: if member();
  allow create: if request.auth != null
    && request.resource.data.caller == request.auth.uid
    && request.resource.data.callee is string
    && request.resource.data.callee != request.auth.uid
    && request.resource.data.members == [request.auth.uid, request.resource.data.callee]
    && request.resource.data.status == 'ringing'
    && request.resource.data.video is bool
    && request.resource.data.createdAt == request.time
    && request.resource.data.keys().hasOnly([
      'caller', 'callerName', 'callee', 'members', 'video', 'status', 'createdAt']);
  allow update: if member()
    && resource.data.status in ['ringing', 'accepted']
    && (
      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['ended', 'declined', 'busy'])
      || (request.auth.uid == resource.data.caller
        && resource.data.status == 'ringing'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer']))
      || (request.auth.uid == resource.data.callee
        && resource.data.status == 'ringing'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'status']))
    );
  match /{bucket}/{candidateId} {
    function call() {
      return get(/databases/$(database)/documents/calls/$(callId)).data;
    }
    allow read: if request.auth != null && request.auth.uid in call().members;
    allow create: if request.auth != null
      && call().status in ['ringing', 'accepted']
      && ((bucket == 'callerCandidates' && request.auth.uid == call().caller)
        || (bucket == 'calleeCandidates' && request.auth.uid == call().callee))
      && request.resource.data.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex']);
  }
}
