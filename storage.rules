rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // PRIVATE CHAT VOICE
    match /chat_audio/{chatId}/{senderId}/{messageId}/{fileName} {
      function member() {
        return signedIn()
          && request.auth.uid in firestore.get(
            /databases/(default)/documents/chats/$(chatId)
          ).data.members;
      }

      allow read: if member();

      allow create, update: if member()
        && request.auth.uid == senderId
        && fileName == 'voice.wav'
        && request.resource.size > 44
        && request.resource.size <= 12582912
        && request.resource.contentType == 'audio/wav';

      allow delete: if member() && request.auth.uid == senderId;
    }

    // PROFILE GALLERY / PROFILE PHOTO SOURCE
    match /profile_media/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(uid)
        && request.resource.size <= 10485760
        && request.resource.contentType.matches('image/.*');
    }

    // MOMENTS
    match /moments/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(uid)
        && request.resource.size <= 15728640
        && request.resource.contentType.matches('image/.*');
    }

    // VIDEOS
    match /videos/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(uid)
        && request.resource.size <= 209715200
        && request.resource.contentType.matches('video/.*');
    }
  }
}
