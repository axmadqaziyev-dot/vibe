rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // İSTİFADƏÇİLƏR
    match /users/{userId} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && request.auth.uid == userId;
    }

    // ŞƏXSİ SÖHBƏTLƏR
    match /chats/{chatId} {

      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] is string
        && request.resource.data.members[1] is string
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members;

      allow read: if signedIn()
        && request.auth.uid in resource.data.members;

      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members.size() == resource.data.members.size()
        && request.resource.data.members.hasAll(resource.data.members);

      match /messages/{messageId} {

        allow read: if signedIn()
          && request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId)).data.members;

        allow create: if signedIn()
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in
            getAfter(/databases/$(database)/documents/chats/$(chatId)).data.members
          && (request.resource.data.type in ['text', 'sticker']
            || (request.resource.data.type == 'audio'
              && request.resource.data.audioPath ==
                'chat_audio/' + chatId + '/' + request.auth.uid + '/' + messageId + '/voice.wav'
              && request.resource.data.durationMs is int
              && request.resource.data.durationMs >= 500
              && request.resource.data.durationMs <= 60000
              && request.resource.data.sizeBytes is int
              && request.resource.data.sizeBytes > 44
              && request.resource.data.sizeBytes <= 12582912));
      }
    }

    // ZƏNGLƏR
    match /calls/{callId} {
      allow read, create, update: if signedIn();

      match /callerCandidates/{candidateId} {
        allow read, write: if signedIn();
      }

      match /calleeCandidates/{candidateId} {
        allow read, write: if signedIn();
      }
    }

    // ANLAR
    match /moments/{momentId} {
      allow read, write: if signedIn();
    }

    // OTAQLAR
    match /socialRooms/{roomId} {
      allow read, write: if signedIn();

      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
    }
  }
}
